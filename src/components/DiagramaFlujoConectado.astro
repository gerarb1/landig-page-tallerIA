---
// DiagramaFlujoConectado.astro - Diagrama lineal del nuevo flujo de trabajo de investigación de 4 pasos
---

<div class="my-6 border-2 border-tinta bg-niebla p-4 sm:p-7 shadow-field space-y-5">
  <!-- Header -->
  <div class="flex flex-wrap items-center justify-between gap-2 border-b border-tinta/20 pb-3">
    <div class="flex items-center gap-2 font-mono text-xs text-tinta/90">
      <span class="w-2.5 h-2.5 bg-trigo inline-block"></span>
      <span class="font-bold">PIPELINE DE INVESTIGACIÓN LINEAL // METODOLOGÍA ACADÉMICA</span>
    </div>
    <span class="font-mono text-[10px] sm:text-[11px] bg-tierra text-trigo font-bold px-2.5 py-0.5">
      FLUJO DE 4 PASOS CONECTADOS
    </span>
  </div>

  <!-- Detailed Linear Flowchart SVG -->
  <div class="w-full overflow-x-auto">
    <svg 
      class="w-full h-auto min-w-[960px] max-w-6xl mx-auto" 
      viewBox="0 0 1080 340" 
      fill="none" 
      xmlns="http://www.w3.org/2000/svg"
      role="img"
      aria-label="Diagrama lineal del flujo de 4 pasos: Gemini (Exploración teórica), Google Scholar (Fuentes reales), Exportar RIS (Citas RefMan), NotebookLM (Síntesis y marco teórico), y pulido final en Google Docs"
    >
      <!-- Base Background Grid Panel -->
      <rect width="1080" height="340" fill="#DCE3D9" rx="4"/>
      
      <!-- Linear Connecting Pipe / Track -->
      <line x1="50" y1="135" x2="1030" y2="135" stroke="#1F2318" stroke-width="4"/>
      <line x1="50" y1="135" x2="1030" y2="135" stroke="#C9A227" stroke-width="2" stroke-dasharray="8 6"/>

      <!-- ================= NODE 1: GEMINI ================= -->
      <g transform="translate(25, 35)">
        <rect x="0" y="0" width="180" height="200" rx="4" fill="#FAF8F3" stroke="#1F2318" stroke-width="1.8"/>
        <!-- Header badge -->
        <rect x="0" y="0" width="180" height="28" rx="4" fill="#46573C"/>
        <text x="90" y="18" fill="#E8E4D6" font-family="'IBM Plex Mono', monospace" font-size="10" font-weight="bold" text-anchor="middle">01 · GEMINI</text>
        
        <!-- Node title -->
        <text x="90" y="52" fill="#1F2318" font-family="'Fraunces', serif" font-size="13" font-weight="bold" text-anchor="middle">Exploración Teórica</text>
        <line x1="20" y1="60" x2="160" y2="60" stroke="#1F2318" stroke-width="0.8"/>
        
        <!-- Bullets -->
        <text x="14" y="80" fill="#1F2318" font-family="'Public Sans', sans-serif" font-size="9.5">
          <tspan x="14" dy="0">• 3–5 ejes teóricos clave</tspan>
          <tspan x="14" dy="16">• Matriz conceptual</tspan>
          <tspan x="14" dy="16">• Hipótesis de trabajo</tspan>
          <tspan x="14" dy="16">• Citas preliminares</tspan>
        </text>

        <!-- Stage badge -->
        <rect x="10" y="160" width="160" height="26" rx="2" fill="#46573C" opacity="0.15"/>
        <text x="90" y="177" fill="#46573C" font-family="'IBM Plex Mono', monospace" font-size="8.5" font-weight="bold" text-anchor="middle">SALIDA: Ejes & Conceptos</text>
      </g>

      <!-- Connection 1 -> 2 -->
      <g transform="translate(210, 125)">
        <circle cx="10" cy="10" r="12" fill="#46573C" stroke="#1F2318" stroke-width="1.5"/>
        <path d="M7 10 L13 10 M10 7 L13 10 L10 13" stroke="#E8E4D6" stroke-width="2" stroke-linecap="round"/>
      </g>

      <!-- ================= NODE 2: GOOGLE SCHOLAR ================= -->
      <g transform="translate(235, 35)">
        <rect x="0" y="0" width="180" height="200" rx="4" fill="#FAF8F3" stroke="#1F2318" stroke-width="1.8"/>
        <!-- Header badge -->
        <rect x="0" y="0" width="180" height="28" rx="4" fill="#46573C"/>
        <text x="90" y="18" fill="#E8E4D6" font-family="'IBM Plex Mono', monospace" font-size="10" font-weight="bold" text-anchor="middle">02 · SCHOLAR</text>
        
        <!-- Node title -->
        <text x="90" y="52" fill="#1F2318" font-family="'Fraunces', serif" font-size="13" font-weight="bold" text-anchor="middle">Fuentes Reales</text>
        <line x1="20" y1="60" x2="160" y2="60" stroke="#1F2318" stroke-width="0.8"/>
        
        <!-- Bullets -->
        <text x="14" y="80" fill="#1F2318" font-family="'Public Sans', sans-serif" font-size="9.5">
          <tspan x="14" dy="0">• Papers empíricos reales</tspan>
          <tspan x="14" dy="16">• Revisiones sistemáticas</tspan>
          <tspan x="14" dy="16">• Reemplazo de hipótesis</tspan>
          <tspan x="14" dy="16">• Sin costo ni registro</tspan>
        </text>

        <!-- Stage badge -->
        <rect x="10" y="160" width="160" height="26" rx="2" fill="#46573C" opacity="0.15"/>
        <text x="90" y="177" fill="#46573C" font-family="'IBM Plex Mono', monospace" font-size="8.5" font-weight="bold" text-anchor="middle">SALIDA: Artículos Reales</text>
      </g>

      <!-- Connection 2 -> 3 -->
      <g transform="translate(420, 125)">
        <circle cx="10" cy="10" r="12" fill="#C9A227" stroke="#1F2318" stroke-width="1.5"/>
        <path d="M7 10 L13 10 M10 7 L13 10 L10 13" stroke="#1F2318" stroke-width="2" stroke-linecap="round"/>
      </g>

      <!-- ================= NODE 3: EXPORTAR RIS ================= -->
      <g transform="translate(445, 35)">
        <rect x="0" y="0" width="180" height="200" rx="4" fill="#FAF8F3" stroke="#1F2318" stroke-width="1.8"/>
        <!-- Header badge -->
        <rect x="0" y="0" width="180" height="28" rx="4" fill="#2B2418"/>
        <text x="90" y="18" fill="#C9A227" font-family="'IBM Plex Mono', monospace" font-size="10" font-weight="bold" text-anchor="middle">03 · CITAS RIS</text>
        
        <!-- Node title -->
        <text x="90" y="52" fill="#1F2318" font-family="'Fraunces', serif" font-size="13" font-weight="bold" text-anchor="middle">Exportar RefMan</text>
        <line x1="20" y1="60" x2="160" y2="60" stroke="#1F2318" stroke-width="0.8"/>
        
        <!-- Bullets -->
        <text x="14" y="80" fill="#1F2318" font-family="'Public Sans', sans-serif" font-size="9.5">
          <tspan x="14" dy="0">• Clic en "Citar" bajo paper</tspan>
          <tspan x="14" dy="16">• Descarga de archivo .ris</tspan>
          <tspan x="14" dy="16">• Colección de PDFs</tspan>
          <tspan x="14" dy="16">• Opción "Mi biblioteca"</tspan>
        </text>

        <!-- Stage badge -->
        <rect x="10" y="160" width="160" height="26" rx="2" fill="#C9A227" opacity="0.25"/>
        <text x="90" y="177" fill="#2B2418" font-family="'IBM Plex Mono', monospace" font-size="8.5" font-weight="bold" text-anchor="middle">SALIDA: PDFs + Archivo .ris</text>
      </g>

      <!-- Connection 3 -> 4 -->
      <g transform="translate(630, 125)">
        <circle cx="10" cy="10" r="12" fill="#46573C" stroke="#1F2318" stroke-width="1.5"/>
        <path d="M7 10 L13 10 M10 7 L13 10 L10 13" stroke="#E8E4D6" stroke-width="2" stroke-linecap="round"/>
      </g>

      <!-- ================= NODE 4: NOTEBOOKLM ================= -->
      <g transform="translate(655, 35)">
        <rect x="0" y="0" width="190" height="200" rx="4" fill="#FFFDF8" stroke="#46573C" stroke-width="2"/>
        <!-- Header badge -->
        <rect x="0" y="0" width="190" height="28" rx="4" fill="#46573C"/>
        <text x="95" y="18" fill="#E8E4D6" font-family="'IBM Plex Mono', monospace" font-size="10" font-weight="bold" text-anchor="middle">04 · NOTEBOOKLM</text>
        
        <!-- Node title -->
        <text x="95" y="52" fill="#1F2318" font-family="'Fraunces', serif" font-size="13" font-weight="bold" text-anchor="middle">Síntesis & Marco</text>
        <line x1="20" y1="60" x2="170" y2="60" stroke="#1F2318" stroke-width="0.8"/>
        
        <!-- Bullets -->
        <text x="14" y="80" fill="#1F2318" font-family="'Public Sans', sans-serif" font-size="9.5">
          <tspan x="14" dy="0">• Carga estructurada de PDFs</tspan>
          <tspan x="14" dy="16">• Citas ancladas a página</tspan>
          <tspan x="14" dy="16">• Síntesis rigurosa sin inventos</tspan>
          <tspan x="14" dy="16">• Redacción de borrador (1000 p.)</tspan>
        </text>

        <!-- Stage badge -->
        <rect x="10" y="160" width="170" height="26" rx="2" fill="#46573C" opacity="0.15"/>
        <text x="95" y="177" fill="#1F2318" font-family="'IBM Plex Mono', monospace" font-size="8.5" font-weight="bold" text-anchor="middle">SALIDA: Borrador con Evidencia</text>
      </g>

      <!-- Connection 4 -> Final -->
      <g transform="translate(850, 125)">
        <circle cx="10" cy="10" r="12" fill="#C9A227" stroke="#1F2318" stroke-width="1.5"/>
        <path d="M7 10 L13 10 M10 7 L13 10 L10 13" stroke="#1F2318" stroke-width="2" stroke-linecap="round"/>
      </g>

      <!-- ================= FINAL DELIVERABLE: DOCS ================= -->
      <g transform="translate(875, 35)">
        <rect x="0" y="0" width="180" height="200" rx="4" fill="#C9A227" fill-opacity="0.3" stroke="#1F2318" stroke-width="2"/>
        <!-- Header badge -->
        <rect x="0" y="0" width="180" height="28" rx="4" fill="#2B2418"/>
        <text x="90" y="18" fill="#C9A227" font-family="'IBM Plex Mono', monospace" font-size="9.5" font-weight="bold" text-anchor="middle">CIERRE // DOCS</text>
        
        <!-- Node title -->
        <text x="90" y="52" fill="#1F2318" font-family="'Fraunces', serif" font-size="12.5" font-weight="bold" text-anchor="middle">Pulido Definitivo</text>
        <line x1="20" y1="60" x2="160" y2="60" stroke="#1F2318" stroke-width="0.8"/>
        
        <!-- Bullets -->
        <text x="14" y="80" fill="#1F2318" font-family="'Public Sans', sans-serif" font-size="9">
          <tspan x="14" dy="0">✔ Pegado en Google Docs</tspan>
          <tspan x="14" dy="16">✔ Panel Gemini integrado</tspan>
          <tspan x="14" dy="16">✔ Cohesión y transiciones</tspan>
          <tspan x="14" dy="16">✔ Marco teórico final</tspan>
        </text>

        <!-- Stage badge -->
        <rect x="10" y="160" width="160" height="26" rx="2" fill="#C9A227" stroke="#1F2318" stroke-width="0.8"/>
        <text x="90" y="177" fill="#1F2318" font-family="'IBM Plex Mono', monospace" font-size="8.5" font-weight="bold" text-anchor="middle">100% VERIFICADO</text>
      </g>

      <!-- Bottom Timeline Sequence Indicators -->
      <g transform="translate(20, 255)">
        <rect x="0" y="0" width="1040" height="68" rx="4" fill="#FAF8F3" stroke="#1F2318" stroke-width="1.2"/>
        <text x="20" y="24" fill="#46573C" font-family="'IBM Plex Mono', monospace" font-size="11" font-weight="bold">FASE 1: HIPÓTESIS DE TRABAJO</text>
        <text x="20" y="42" fill="#1F2318" font-family="'Public Sans', sans-serif" font-size="10" opacity="0.85">Gemini mapea posibles ejes y conceptos</text>
        <text x="20" y="55" fill="#1F2318" font-family="'Public Sans', sans-serif" font-size="10" opacity="0.85">preliminares sin citas definitivas.</text>

        <line x1="350" y1="10" x2="350" y2="58" stroke="#1F2318" stroke-width="1" stroke-dasharray="3 3"/>

        <text x="370" y="24" fill="#46573C" font-family="'IBM Plex Mono', monospace" font-size="11" font-weight="bold">FASE 2: EVIDENCIA REAL</text>
        <text x="370" y="42" fill="#1F2318" font-family="'Public Sans', sans-serif" font-size="10" opacity="0.85">Google Scholar localiza artículos empíricos</text>
        <text x="370" y="55" fill="#1F2318" font-family="'Public Sans', sans-serif" font-size="10" opacity="0.85">y se exportan en formato .ris (RefMan).</text>

        <line x1="710" y1="10" x2="710" y2="58" stroke="#1F2318" stroke-width="1" stroke-dasharray="3 3"/>

        <text x="730" y="24" fill="#46573C" font-family="'IBM Plex Mono', monospace" font-size="11" font-weight="bold">FASE 3: SÍNTESIS & REDACCIÓN</text>
        <text x="730" y="42" fill="#1F2318" font-family="'Public Sans', sans-serif" font-size="10" opacity="0.85">NotebookLM redacta anclado a los PDFs;</text>
        <text x="730" y="55" fill="#1F2318" font-family="'Public Sans', sans-serif" font-size="10" opacity="0.85">Google Docs pule la versión definitiva.</text>
      </g>
    </svg>
  </div>

  <div class="pt-2 border-t border-tinta/10 flex flex-wrap items-center justify-between text-[11px] font-mono text-tinta/75">
    <span>FLUJO SECUENCIAL DE INVESTIGACIÓN: GEMINI → GOOGLE SCHOLAR → EXPORTAR RIS → NOTEBOOKLM</span>
    <span class="text-musgo font-bold">RECORRIDO EN 4 PASOS SIN ALUCINACIONES</span>
  </div>
</div>
