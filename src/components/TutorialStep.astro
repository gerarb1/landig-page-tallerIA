---
interface Props {
  stepNumber: number;
  title: string;
  instruction: string;
  caption?: string;
  imageSrc?: string;
  isLast?: boolean;
  showMedia?: boolean;
}

const {
  stepNumber,
  title,
  instruction,
  caption = "",
  imageSrc,
  isLast = false,
  showMedia = true,
} = Astro.props;
---

<div class="relative flex gap-3.5 sm:gap-5 group">
  <!-- Left Step Indicator & Connecting Trail Line -->
  <div class="flex flex-col items-center">
    <!-- Step Circle Number -->
    <div class="w-7 h-7 sm:w-8 sm:h-8 rounded-full bg-musgo text-papel font-mono text-xs font-bold flex items-center justify-center border-2 border-tinta shadow-xs z-10 shrink-0">
      {stepNumber}
    </div>
    
    <!-- Vertical connecting line (sendero continuo) -->
    {!isLast && (
      <div class="w-0.5 grow bg-musgo/40 my-1.5 border-l-2 border-dashed border-musgo/60 min-h-[2.5rem]"></div>
    )}
  </div>

  <!-- Right Content Area -->
  <div class={`grow ${isLast ? 'pb-2' : 'pb-7'} space-y-2.5`}>
    <!-- Step Header -->
    <div>
      <div class="flex items-center gap-2 mb-0.5">
        <span class="font-mono text-[10px] sm:text-[11px] text-musgo font-bold tracking-wider uppercase bg-musgo/10 px-1.5 py-0.5 border border-musgo/30">
          PASO {stepNumber}
        </span>
        <h4 class="font-fraunces text-base sm:text-lg font-bold text-tinta leading-snug">
          {title}
        </h4>
      </div>
    </div>

    <!-- Instruction text -->
    <p class="font-sans text-xs sm:text-sm text-tinta/85 leading-relaxed">
      {instruction}
    </p>

    <!-- Screenshot Placeholder or Actual Image -->
    {showMedia && (
      <div class="pt-1">
        {imageSrc ? (
          <div class="border-2 border-tinta rounded-[4px] overflow-hidden shadow-xs bg-white">
            <img src={imageSrc} alt={`Captura de pantalla: ${title}`} class="w-full h-auto object-cover" />
            {caption && <p class="p-2 font-mono text-[10px] text-tinta/70 bg-niebla border-t border-tinta/20">{caption}</p>}
          </div>
        ) : (
          <div class="border-2 border-dashed border-musgo/70 bg-niebla rounded-[4px] p-4 sm:p-6 flex flex-col items-center justify-center text-center space-y-1.5 transition-colors hover:bg-niebla/70">
            <div class="flex items-center gap-2 font-mono text-xs font-semibold text-musgo">
              <svg class="w-4 h-4 text-musgo shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
              </svg>
              <span>Captura pendiente — Paso {stepNumber}</span>
            </div>
            {caption && (
              <p class="font-mono text-[11px] text-tinta/70 max-w-md">
                [{caption}]
              </p>
            )}
          </div>
        )}
      </div>
    )}
  </div>
</div>
