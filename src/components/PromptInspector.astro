---
interface Props {
  protocolId?: string;
  title: string;
  role?: string;
  inputData?: string;
  outputFormat?: string;
  promptText: string;
  badgeRight?: string;
  badgeLeft?: string;
  engine?: string;
}

const {
  protocolId = "PROT-01",
  title = "Calibración de Contexto Agronómico",
  role = "",
  inputData = "",
  outputFormat = "",
  promptText = "",
  badgeRight = "// LISTO PARA COPIAR",
  badgeLeft = "PROMPT LITERAL (CÓDIGO DE CAMPO)",
  engine = "MOTOR: GEMINI PRO // NOTEBOOKLM",
} = Astro.props;

const hasMetadata = Boolean(role || inputData || outputFormat);
---

<div class="border-2 border-tinta bg-tierra text-papel rounded-none p-5 shadow-field my-4 font-mono text-xs">
  <div class="flex flex-wrap items-center justify-between gap-2 border-b border-papel/20 pb-3 mb-3">
    <div class="flex items-center gap-2">
      <span class="px-2 py-0.5 bg-trigo text-tierra font-bold text-[11px]">
        {protocolId}
      </span>
      <span class="text-trigo font-semibold text-xs">{title}</span>
    </div>
    <span class="text-papel/50 text-[10px]">{engine}</span>
  </div>

  {hasMetadata && (
    <div class="grid grid-cols-1 md:grid-cols-3 gap-3 mb-3 text-[11px] text-papel/80">
      {role && (
        <div class="bg-tinta/60 p-2.5 border border-papel/10">
          <strong class="text-trigo block mb-1">// ROL DEFINIDO:</strong>
          <p class="font-sans text-xs">{role}</p>
        </div>
      )}
      {inputData && (
        <div class="bg-tinta/60 p-2.5 border border-papel/10">
          <strong class="text-trigo block mb-1">// PARÁMETROS DE ENTRADA:</strong>
          <p class="font-sans text-xs">{inputData}</p>
        </div>
      )}
      {outputFormat && (
        <div class="bg-tinta/60 p-2.5 border border-papel/10">
          <strong class="text-trigo block mb-1">// FORMATO DE SALIDA:</strong>
          <p class="font-sans text-xs">{outputFormat}</p>
        </div>
      )}
    </div>
  )}

  <!-- Prompt Code Block -->
  <div class="relative">
    <div class="text-[10px] text-papel/40 pb-1 flex justify-between items-center">
      <span>{badgeLeft}</span>
      <span class="text-trigo text-[10px] font-bold">{badgeRight}</span>
    </div>
    <pre class="bg-tinta p-3.5 border border-papel/20 text-papel/90 text-xs overflow-x-auto whitespace-pre-wrap font-mono leading-relaxed select-all">{promptText}</pre>
  </div>
</div>
